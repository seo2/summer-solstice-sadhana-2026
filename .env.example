# Public PWA config. This file is safe to commit.
# Copy to .env.local for local testing; deploy these same vars in the hosting platform.

# Required for automatic sending. Production should point to the 3HO WordPress endpoint.
NEXT_PUBLIC_CONTACT_ENDPOINT="https://www.3ho.org/wp-json/3ho-solstice/v1/contact"

# Used only for the email-draft fallback in the app UI.
# Testing:
NEXT_PUBLIC_CONTACT_EMAIL="developer@3ho.org"

# Production:
# NEXT_PUBLIC_CONTACT_EMAIL="registration@3ho.org"
